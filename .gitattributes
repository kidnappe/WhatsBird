# ============================================================
# 行尾与二进制属性
# ============================================================

# 仓库内规范化，检出时按类型还原。
* text=auto

# ⚠️ Windows 批处理必须 CRLF —— 这是硬约束，不是风格偏好。
# cmd.exe 解析 LF 行尾会吞字符、报「'xxx' 不是内部或外部命令」等乱码错误
# （项目里 2026-10-06 实毁过 start_dashboard.bat 第 39 行）。
# 没有下面这两行，Linux/macOS 用户 clone 下来的 .bat 全是 LF，双击即坏。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：禁止任何行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.7z   binary
*.jar  binary
*.aar  binary
*.xlsx binary
*.db   binary

# ============================================================
# Git LFS：大文件不进普通对象库
# ============================================================
# 模型权重约 103MB（区域分类器 62MB + 检测器 26MB + 拒识 9.5MB + 基线 4MB）。
# 走 LFS 后 clone 只拉指针，按需 fetch。
*.tflite filter=lfs diff=lfs merge=lfs -text
*.onnx   filter=lfs diff=lfs merge=lfs -text
*.pth    filter=lfs diff=lfs merge=lfs -text
*.pt     filter=lfs diff=lfs merge=lfs -text

# 生成型数据资产（离线区划 7.6MB；地理先验每区约 0.8MB × 5）
android/app/src/main/assets/geo/*.ndjson filter=lfs diff=lfs merge=lfs -text
android/app/src/main/assets/prior/*.json filter=lfs diff=lfs merge=lfs -text
